# =============================================================================
# TWO SEPARATE SUPABASE PROJECTS
# =============================================================================
# 1) AUTH project  — login / JWT verification only
# 2) DATA project  — Postgres via DATABASE_URL only (Sequelize)
# Do NOT use the data project URL for authentication.
# =============================================================================

# --- Auth Supabase (preferred names) ---
AUTH_SUPABASE_URL=https://your-auth-project.supabase.co
AUTH_SUPABASE_PUBLISHABLE_KEY=your-auth-publishable-key
AUTH_SUPABASE_SECRET_KEY=
AUTH_SUPABASE_JWKS_URL=

# Legacy auth aliases (still supported if AUTH_* are unset):
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_JWKS_URL=

# --- Data Supabase Postgres (different project) ---
# Host: db.sckuxldttzxrriqtseyz.supabase.co
# Replace [DATABASE_PASSWORD] with the password from:
#   Data project → Project Settings → Database
# Percent-encode special characters in the password (e.g. @ → %40, # → %23).
DATABASE_URL=postgresql://postgres:[DATABASE_PASSWORD]@db.sckuxldttzxrriqtseyz.supabase.co:5432/postgres

# Leave DATABASE_URL empty only for local SQLite fallback during offline/dev.
# DATABASE_URL=

PORT=8080
